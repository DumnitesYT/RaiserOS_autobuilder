# ══════════════════════════════════════════
#  RaiserOS Builder — конфиг
# ══════════════════════════════════════════

ROM_BRAND="RaiserOS"
ROM_BRAND_VERSION="1.0"

# ── Моды ───────────────────────────────────
DEBLOAT=true
DISABLE_OTA=true
FIX_GOOGLE_PLAY=true
FIX_BATTERY=true
BRAND_OTA_CARD=true
INSTALL_KAORI_TOOLBOX=true
ADD_HOSTS_BLOCKER=false
INSTALL_GAPPS=false
GAPPS_VARIANT="pico"

# ── Упаковка ───────────────────────────────
REPACK_TYPE="auto"        # auto | EXT | EROFS
COMPRESS_LEVEL=9

# ── Загрузка ───────────────────────────────
UPLOAD_TO_RELEASES=true
UPLOAD_TO_RCLONE=false
RCLONE_REMOTE="onedrive"
RCLONE_PATH="RaiserOS-Builds"

# ── Метаданные (авто-определяются) ─────────
ROM_DEVICE=""
ROM_VERSION=""
ROM_BUILD_DATE=""
